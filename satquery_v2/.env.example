# SatQuery AI — configuration
# ---------------------------------------------------------------------------
# Copy to `.env` (same folder as app.py) and fill in your values.
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit a real token, and never paste one into
# a chat, an issue, or a screenshot — a leaked token can be used to read every
# private repo your account can see. Rotate at huggingface.co/settings/tokens.
# ---------------------------------------------------------------------------

# REQUIRED. The fine-tuned model or LoRA adapter to run.
HF_MODEL_ID=aanandmodi/satquery-qwen3vl-bigearthnet-txt-lora

# REQUIRED for a private or gated repo. A read-scoped token is enough.
HF_TOKEN=

# Optional. Base model for a LoRA adapter. Leave blank to read it from the
# adapter's own adapter_config.json, which is the reliable source.
# HF_BASE_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct

# --- Hardware --------------------------------------------------------------
HF_DEVICE=auto          # auto | cuda | mps | cpu
# HF_DTYPE=auto         # auto | bfloat16 | float16 | float32
# HF_LOAD_IN_4BIT=0     # 1 to quantise (needs bitsandbytes + CUDA).
                        # An 8B model drops from ~16 GB to ~6 GB of VRAM.

# --- Generation ------------------------------------------------------------
# HF_MAX_NEW_TOKENS=256
# HF_TEMPERATURE=0.2    # near-greedy: this is an analysis tool, not a chatbot
# HF_MAX_IMAGE_PX=768   # longest edge fed to the vision tower

# --- Behaviour -------------------------------------------------------------
# HF_ENABLED=1          # 0 runs entirely on local specialists, no model load
# HF_EAGER_LOAD=1       # load at startup rather than on first request
# HF_LOCAL_ONLY=0       # 1 forbids network access; use the local cache only

# --- Server ----------------------------------------------------------------
# SATQUERY_HOST=127.0.0.1   # 0.0.0.0 in Docker or Colab
# SATQUERY_PORT=8000

# Optional: dataset-trained captioning checkpoint for the local fallback.
# SATQUERY_CAPTION_CHECKPOINT=models/captioning.json
